import { readFileSync } from 'node:fs';

/** The geometry and colors of the Scrim mark, read from `brand/scrim-mark.svg`. */
export interface ParsedMark {
  viewBox: string;
  size: number;
  cornerRadius: number;
  brackets: string;
  bracketStrokeWidth: number;
  dot: { cx: number; cy: number; r: number };
  colors: { tile: string; glyph: string };
}

function attr(tag: string, name: string): string {
  const match = new RegExp(String.raw`\s${name}="([^"]*)"`).exec(tag);
  if (match?.[1] === undefined) throw new Error(`The mark svg is missing ${name} on ${tag}`);
  return match[1];
}

function tagOf(svg: string, name: string): string {
  const match = new RegExp(String.raw`<${name}\b[^>]*>`).exec(svg);
  if (!match) throw new Error(`The mark svg has no <${name}> element`);
  return match[0];
}

/** Reads the plain, hand written mark svg. It is strict on purpose: one rect, one path, one circle. */
export function parseMark(svg: string): ParsedMark {
  const rect = tagOf(svg, 'rect');
  const path = tagOf(svg, 'path');
  const circle = tagOf(svg, 'circle');
  const viewBox = attr(tagOf(svg, 'svg'), 'viewBox');
  const size = Number(attr(rect, 'width'));
  if (viewBox !== `0 0 ${size} ${size}`) throw new Error(`Unexpected viewBox ${viewBox}`);
  return {
    viewBox,
    size,
    cornerRadius: Number(attr(rect, 'rx')),
    brackets: attr(path, 'd'),
    bracketStrokeWidth: Number(attr(path, 'stroke-width')),
    dot: {
      cx: Number(attr(circle, 'cx')),
      cy: Number(attr(circle, 'cy')),
      r: Number(attr(circle, 'r')),
    },
    colors: { tile: attr(rect, 'fill').toUpperCase(), glyph: attr(path, 'stroke').toUpperCase() },
  };
}

export function readMark(file: string | URL): ParsedMark {
  return parseMark(readFileSync(file, 'utf8'));
}

/** The source of `src/mark.ts`. */
export function renderMarkModule(mark: ParsedMark): string {
  return `// Generated by \`pnpm icons\` from brand/scrim-mark.svg. Do not edit by hand.
export const MARK = {
  viewBox: '${mark.viewBox}',
  size: ${mark.size},
  cornerRadius: ${mark.cornerRadius},
  brackets:
    '${mark.brackets}',
  bracketStrokeWidth: ${mark.bracketStrokeWidth},
  dot: { cx: ${mark.dot.cx}, cy: ${mark.dot.cy}, r: ${mark.dot.r} },
} as const;

/** The two colors of the mark, as literal values for files that cannot read CSS variables. */
export const MARK_COLORS = { tile: '${mark.colors.tile}', glyph: '${mark.colors.glyph}' } as const;
`;
}
