# Copy to .env for local development. Never commit .env.
# These values match the throwaway services in docker-compose.yml.

# Pooled connection for the running app (Supabase transaction pooler: port 6543, pgbouncer=true).
DATABASE_URL=postgresql://scrim:scrim@localhost:5432/scrim
# Direct connection or session pooler for migrations (Supabase port 5432).
DIRECT_URL=postgresql://scrim:scrim@localhost:5432/scrim

# Mail transport. Mailpit catches everything at http://localhost:8025 in development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Scrim <hello@example.com>

# Random secret of at least 32 characters used to hash IP addresses.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=change-me-generate-a-random-value-of-32-bytes

# Public origin, used for links and origin checks.
SITE_URL=http://localhost:3000

# Repository used for release lookups. The token is optional and only raises GitHub rate limits.
GITHUB_REPO=oyedokunken/scrim
GITHUB_TOKEN=
