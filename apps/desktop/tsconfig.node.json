{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": [
    "electron.vite.config.ts",
    "electron-builder.config.ts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/recorder/protocol.ts",
    "src/recorder/protocol-schemas.ts",
    "src/recorder/preload/**/*",
    "tests/unit/**/*",
    "build/**/*",
    "scripts/**/*",
    "../../packages/tokens/scripts/mark-source.mts"
  ],
  "exclude": [
    "tests/unit/track-recorder.test.ts",
    "tests/unit/recorder-controller.test.ts",
    "tests/unit/support/recorder-fakes.ts"
  ]
}
